{
  "name": "friotrack",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "demo": "npm run db:up && npm run db:init && npm run db:seed && npm run dev",
    "dev": "concurrently -k -n api,gateway,admin,web \"npm:dev:api\" \"npm:gateway\" \"npm:admin\" \"npm:dev:web\"",
    "dev:api": "tsx watch apps/api/src/server.ts",
    "dev:web": "vite --config apps/web/vite.config.ts",
    "db:up": "docker compose up -d",
    "db:init": "tsx tools/setup.ts",
    "db:seed": "tsx tools/seed.ts",
    "test": "tsx --test tests/*.test.ts",
    "test:integration": "tsx --test tests/integration/*.test.ts",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && vite build --config apps/web/vite.config.ts",
    "simulate": "tsx tools/simulator/index.ts",
    "archive": "tsx tools/archive.ts",
    "gateway": "tsx tools/gateway.ts",
    "backup": "tsx tools/backup.ts",
    "test:e2e": "tsx tools/gateway-e2e.ts",
    "admin": "tsx tools/admin.ts"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.900.0",
    "@aws-sdk/lib-dynamodb": "^3.900.0",
    "@fastify/cors": "^11.1.0",
    "fastify": "^5.6.0",
    "zod": "^4.1.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "lucide-react": "^0.468.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^9.2.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0"
  }
}
